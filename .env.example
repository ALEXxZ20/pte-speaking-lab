# 复制为项目根目录 .env；仅后端读取。不要给密钥添加 VITE_ 前缀。
# 相对路径以项目根目录为基准。
PTE_DATA_DIR=./data
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe

# WhisperX 在 CPU 上运行；设为 none 可跳过词级对齐并降级相关指标。
LLM_PROVIDER=openai
ALIGNMENT_PROVIDER=whisperx
PRONUNCIATION_PROVIDER=none
ASR_PROVIDER=none
TTS_ENABLED=true
TTS_VOICE=en-US-AriaNeural
TTS_RATE=+0%
TTS_GAP_MS=300
TTS_TIMEOUT_S=90
OPENAI_API_KEY=
OPENAI_ANALYSIS_MODEL=
# 当 LLM_PROVIDER=openai_compatible 时，填兼容服务的 /v1 地址；本机 CLIProxyAPI 示例：
OPENAI_BASE_URL=

# 内网服务：先构建前端，再用 ./scripts/start.sh 后台启动；stop.sh/restart.sh 管理服务。
# 将地址换为 Mac 当前内网 IP，并在路由器上为这台 Mac 保留同一 DHCP 地址。
# 仅在可信内网使用；HTTP Basic 在普通 HTTP 上不加密。
PTE_LAN_MODE=false
PTE_LAN_BIND_IP=192.168.5.14
PTE_LAN_PORT=8765
PTE_LAN_USERNAME=pte
PTE_LAN_PASSWORD=
